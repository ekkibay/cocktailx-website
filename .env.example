# Vorlage. Echte Werte gehoeren in .env.local, die nicht im Repository liegt.
# Keine Schluessel in dieser Datei, sie ist oeffentlich.

# Mailgun, fuer die Formulare auf der Website
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# Meta Business Suite, Domainbestaetigung. Optional.
META_DOMAIN_VERIFICATION=

# Stripe, nur lesend fuer das Verkaufsdashboard unter /intern/dashboard.
# Ohne diesen Schluessel zeigt die Seite Demodaten und sagt das auch.
# Ein Restricted Key mit Leserecht auf Charges und PaymentIntents reicht.
STRIPE_SECRET_KEY=

# Der interne Bereich ist im Betrieb aus und muss ausdruecklich an.
# In der Entwicklung ist er ohne diese Zeile offen.
# Achtung: Das ist keine Anmeldung. Wer ihn dauerhaft ins Netz stellt,
# braucht den Zugriffsschutz des Hosters davor. Er zeigt Namen und Adressen.
DASHBOARD_ENABLED=

# Easybill, fuer den Abgleich der Positionen im Cateringgeschaeft
EASYBILL_API_KEY=

# Ticketmodul. Nur noetig, wo der Shop laeuft, nicht auf der Website.
# TICKET_CODE_SECRET schuetzt die Hashes der Codes, mindestens 32 Zeichen.
# TICKET_WINDOWS ist die Fensterkonfiguration als JSON.
TICKET_CODE_SECRET=
TICKET_WINDOWS=

# Microsoft Graph, nur lesend fuer den Supportbereich unter /intern/support.
# Ohne diese vier Werte zeigt die Seite Demodaten und sagt das auch.
# Einrichtung Schritt fuer Schritt: docs/intern-support-mail.md
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
SUPPORT_MAILBOX=

# Newsletter, Double Opt-in.
# NEWSLETTER_SECRET signiert die Bestaetigungslinks, mindestens 32 Zeichen.
# Erzeugen: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Wird er gewechselt, verfallen alle offenen Bestaetigungslinks.
NEWSLETTER_SECRET=
# Adresse der Mailgun-Mailingliste, etwa onice@mg.cocktail-x.com
MAILGUN_NEWSLETTER_LIST=
# Basisadresse fuer absolute Links in Mails. Ohne sie wird die des Aufrufs benutzt.
NEXT_PUBLIC_SITE_URL=https://cocktail-x.com
